{
  "name": "@len3hq/covenant-mcp",
  "version": "0.1.0",
  "description": "An MCP server that gives any AI assistant a Covenant vault to pay from.",
  "keywords": [
    "covenant",
    "mcp",
    "model-context-protocol",
    "near",
    "ai-agent",
    "wallet",
    "payments"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Len3hq/covenant.git",
    "directory": "mcp"
  },
  "homepage": "https://covenant.len3.xyz/?docs",
  "bugs": {
    "url": "https://github.com/Len3hq/covenant/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "covenant-mcp": "dist/index.js"
  },
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint src && tsc --noEmit",
    "test": "vitest run",
    "build": "tsc",
    "start": "node dist/index.js",
    "prepack": "rm -rf dist && tsc"
  },
  "dependencies": {
    "@len3hq/covenant-sdk": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
