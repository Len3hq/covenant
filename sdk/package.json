{
  "name": "@len3hq/covenant-sdk",
  "version": "0.1.2",
  "description": "A policy-enforced wallet for AI agents: pay on Bitcoin, Base and Solana, and across chains, through a Covenant vault on NEAR.",
  "license": "Apache-2.0",
  "keywords": [
    "covenant",
    "near",
    "chain-signatures",
    "ai-agent",
    "wallet",
    "bitcoin",
    "solana",
    "base"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Len3hq/covenant.git",
    "directory": "sdk"
  },
  "homepage": "https://covenant.len3.xyz/?docs",
  "bugs": {
    "url": "https://github.com/Len3hq/covenant/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint src && tsc",
    "test": "tsc && vitest run",
    "build": "tsc",
    "prepack": "rm -rf dist && tsc"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "bitcoinjs-lib": "^7.0.5",
    "near-api-js": "^7.4.0",
    "viem": "^2.57.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
