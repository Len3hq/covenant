# Copy to .env. Never commit real keys. See "Decisions" in docs/BUILD_PLAN.md for how judges get demo access.

# NEAR
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
VAULT_ACCOUNT_ID=
OWNER_ACCOUNT_ID=
# The Sputnik DAO that holds the guardian role. GUARDIAN_ACCOUNT_ID is its council member.
GUARDIAN_DAO_ID=
GUARDIAN_ACCOUNT_ID=
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=
MPC_SIGNER_ACCOUNT_ID=v1.signer-prod.testnet

# Derivation paths. Changing one changes the vault address, so set them once.
BTC_PATH=btc-vault-1
EVM_PATH=evm-vault-1

# Bitcoin testnet4
BTC_API_URL=https://mempool.space/testnet4/api

# Base Sepolia
EVM_CHAIN_ID=84532
EVM_RPC_URL=https://sepolia.base.org
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# LLM. Only needed for live runs; replay mode needs no key.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Payees for `make testnet-smoke`. Both must be on the live policy.
SMOKE_BTC_PAYEE=
SMOKE_EVM_PAYEE=
